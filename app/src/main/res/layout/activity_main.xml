<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#F0F0F0"
        android:padding="12dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="#3DDC84"
            android:foreground="#37C677"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="@string/profile_photo"
            tools:ignore="ContentDescription, ImageContrasCheck"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hello_users"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_active"
                android:textSize="14sp"
                android:textColor="#666666" />

        </LinearLayout>
    </LinearLayout>

    <EditText
        android:id="@+id/etNama"
        android:layout_width="320dp"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:hint="@string/input_name"
        android:inputType="text"
        tools:ignore="Autofill, TextFieldSize" />

    <Button
        android:id="@+id/btnToast"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/show_toast" />

    <Button
        android:id="@+id/btnForm"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/open_form_explicit_intent" />

    <Button
        android:id="@+id/btnBrowser"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/open_website_implicit_intent" />

</LinearLayout>